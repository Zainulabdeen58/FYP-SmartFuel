MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-fuel?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
# Address of the frontend that may call this API
CLIENT_URL=http://localhost:5173

# OpenRouteService key for trip routes and place search (free: openrouteservice.org).
# Without it trips still save, without routes.
ORS_API_KEY=
# Only for tests and offline demos: the fake route service (node dev/fakeOrs.js).
# ORS_BASE_URL=http://localhost:5199

# Used only by "npm run seed:admin" to create the admin account. 
# Password: at least 8 characters with letters and numbers.
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_CONTACT=+92 300 0000000
ADMIN_PASSWORD=
